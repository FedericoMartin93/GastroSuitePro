rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Seguridad GastroSuitePro:
    // Propietario (fefomartin00@gmail.com) tiene control total de lectura y escritura
    // Invitados autenticados solo pueden leer
    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email.lower() == 'fefomartin00@gmail.com';
    }
  }
}
